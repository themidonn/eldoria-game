# ============================================================
#   .gitignore — что Git НЕ должен отслеживать
#   Всё, что здесь перечислено, останется только у тебя локально
#   и не попадёт в репозиторий на GitHub.
# ============================================================


# ============================================================
#   PYTHON
#   Кэш скомпилированного байт-кода — пересоздаётся автоматически
#   при каждом запуске. Хранить в репозитории бессмысленно.
# ============================================================
__pycache__/
*.py[cod]           # .pyc, .pyo, .pyd

# Метаданные editable-install (pip install -e .)
*.egg-info/

# Скомпилированные расширения (Linux/macOS)
*.so


# ============================================================
#   ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
#   У каждого разработчика своё — на GitHub весит сотни мегабайт
#   и несовместимо между ОС.
# ============================================================
venv/
.venv/
env/


# ============================================================
#   НАСТРОЙКИ РЕДАКТОРОВ
#   Личные предпочтения IDE — не часть проекта.
# ============================================================
.idea/
.vscode/


# ============================================================
#   ФАЙЛЫ СБОРКИ
#   PyInstaller (.exe) и Pygbag (веб-версия) — собираются заново.
#
#   ВАЖНО: build/web генерируется GitHub Actions при каждом пуше
#   из исходников. Коммитить его не нужно — он всегда свежий.
# ============================================================
build/
dist/
*.spec


# ============================================================
#   СИСТЕМНЫЙ МУСОР
#   Создаётся ОС при просмотре папок, не нужен в проекте.
# ============================================================
Thumbs.db
.DS_Store


# ============================================================
#   ЛОГИ И ОТЛАДКА
#   Отладочные выводы — на GitHub им не место.
# ============================================================
*.log
pip-log.txt
pip-delete-this-directory.txt


# ============================================================
#   КЭШИ ИНСТРУМЕНТОВ
#   Появляются при запуске линтеров / тестов. Сейчас могут
#   не использоваться, но пусть будут — «на будущее».
# ============================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Покрытие тестами (если добавите pytest-cov)
.coverage
.coverage.*
htmlcov/
coverage.xml


# ============================================================
#   ВРЕМЕННЫЕ ФАЙЛЫ ПРОЕКТА
#   structure.txt — генерируется вручную через `tree` для
#   просмотра структуры. Это не часть проекта, а разовый
#   инструмент. В репозитории ему не место.
# ============================================================
structure.txt

# Резервные копии, которые создают некоторые редакторы
*.bak
*~


# ============================================================
#   ЧТО НЕ ИГНОРИРУЕТСЯ (и почему)
# ------------------------------------------------------------
#   Начинающие часто случайно добавляют сюда лишнее и ломают
#   сборку. Эти файлы ДОЛЖНЫ остаться в репозитории:
#
#     main.py, game.py, settings.py, save.py  — код игры
#     data/, entities/, ui/, world/           — модули
#     assets/                                 — шрифты Tiny5
#     custom.tmpl                             — шаблон Pygbag
#     requirements.txt                        — зависимости
#     .github/workflows/deploy.yml            — CI-деплой
#     README.md                               — документация
# ============================================================